function formatearFechaISO(fecha) {
  if (!fecha) return '';

  return Utilities.formatDate(
    new Date(fecha),
    Session.getScriptTimeZone(),
    'yyyy-MM-dd'
  );
}

function formatearFecha(fecha) {
  if (!fecha) return '';

  return Utilities.formatDate(
    new Date(fecha),
    Session.getScriptTimeZone(),
    'dd/MM/yyyy'
  );
}


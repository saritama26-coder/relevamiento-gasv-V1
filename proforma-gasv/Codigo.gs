   CRUD CLIENTES / SERVICIOS / PROFORMAS
========================= */

function actualizarCliente(data) {
  if (!data || !data.id || !data.nombre || !String(data.nombre).trim()) {
    throw new Error('ID y nombre del cliente son obligatorios.');
  }

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const hoja = ss.getSheetByName('CLIENTES');
  if (!hoja) throw new Error('No existe la hoja CLIENTES.');
  const valores = hoja.getDataRange().getValues();
  const telefono = normalizarTelefonoEcuador(data.telefono);

  for (let i = 1; i < valores.length; i++) {
    if (String(valores[i][0]) === String(data.id)) {
      hoja.getRange(i + 1, 1, 1, 8).setValues([[
        data.id,
        String(data.nombre).trim(),
        data.identificacion || '',
        telefono,
        data.email || '',
        data.direccion || '',
        data.ciudad || '',
        valores[i][7] || new Date()
      ]]);
      hoja.getRange(i + 1, 4).setNumberFormat('@');
      return {ok:true, success:true, message:'Cliente actualizado correctamente.'};
    }
  }

  throw new Error('No se encontró el cliente.');
}

function eliminarCliente(id) {
  if (!id) throw new Error('No se indicó el cliente.');
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const hoja = ss.getSheetByName('CLIENTES');
  if (!hoja) throw new Error('No existe la hoja CLIENTES.');

  const valores = hoja.getDataRange().getValues();
  for (let i = 1; i < valores.length; i++) {
    if (String(valores[i][0]) === String(id)) {
      hoja.deleteRow(i + 1);
      return {ok:true, success:true, message:'Cliente eliminado correctamente.'};
    }
  }
  throw new Error('No se encontró el cliente.');
}

function generarCodigoServicio() {
  const hoja = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('SERVICIOS');
  let mayor = 0;
  if (hoja && hoja.getLastRow() > 1) {
    hoja.getRange(2,2,hoja.getLastRow()-1,1).getValues().flat().forEach(v => {
      const m = String(v || '').match(/^SRV-(\d+)$/i);
      if (m) mayor = Math.max(mayor, Number(m[1]));
    });
  }
  return 'SRV-' + String(mayor + 1).padStart(3,'0');
}

function guardarServicio(data) {
  if (!data || !String(data.servicio || '').trim()) {
    throw new Error('El nombre del servicio es obligatorio.');
  }
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let hoja = ss.getSheetByName('SERVICIOS');
  if (!hoja) {
    configurarSistema();
    hoja = ss.getSheetByName('SERVICIOS');
  }

  const codigo = data.codigo || generarCodigoServicio();
  const id = Utilities.getUuid();
  hoja.appendRow([
    id,
    codigo,
    String(data.servicio).trim(),
    data.categoria || 'Arquitectura',
    data.unidad || 'u',
    Number(data.precio_referencial || data.precio || 0),
    data.descripcion || '',
    String(data.activo === false ? 'NO' : 'SI')
  ]);

  return {ok:true, success:true, id:id, codigo:codigo, message:'Servicio creado correctamente.'};
}

function actualizarProforma(data) {
  if (!data || !data.id) throw new Error('No se indicó la proforma a editar.');

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const hojaP = ss.getSheetByName('PROFORMAS');
  const hojaD = ss.getSheetByName('DETALLE_PROFORMA');
  if (!hojaP || !hojaD) throw new Error('No existen las hojas de proformas.');

  const detallesEntrada = Array.isArray(data.detalles) ? data.detalles : [];
  if (!detallesEntrada.length) throw new Error('Debe existir al menos un servicio.');

  const valoresP = hojaP.getDataRange().getValues();
  let filaP = -1, filaOriginal = null;
  for (let i=1;i<valoresP.length;i++) {
    if (String(valoresP[i][0]) === String(data.id)) {
      filaP = i + 1;
      filaOriginal = valoresP[i];
      break;
    }
  }
  if (filaP < 0) throw new Error('No se encontró la proforma.');

  let subtotal = 0;
  const detalles = [];
  detallesEntrada.forEach(s => {
    const cantidad = Number(s.cantidad || 0);
    const precio = Number(s.precio_unitario || s.precio || 0);
    const sub = cantidad * precio;
    subtotal += sub;
    detalles.push([
      Utilities.getUuid(), data.id, s.tipo_servicio || '', s.descripcion || '',
      s.unidad || '', cantidad, precio, sub, s.observaciones || ''
    ]);
  });
  if (subtotal <= 0) throw new Error('El subtotal de la proforma debe ser mayor que cero.');

  const ivaPorcentaje = data.iva_porcentaje !== undefined && data.iva_porcentaje !== ''
    ? Number(data.iva_porcentaje)
    : Number(obtenerConfiguracion().iva) || 15;
  const iva = subtotal * ivaPorcentaje / 100;
  const total = subtotal + iva;
  const fecha = data.fecha ? new Date(data.fecha + 'T12:00:00') : filaOriginal[2];
  const dias = Math.max(1, Number(data.dias_validez || 30));
  const fechaValidez = new Date(fecha);
  fechaValidez.setDate(fechaValidez.getDate() + dias);

  hojaP.getRange(filaP,1,1,15).setValues([[
    data.id,
    filaOriginal[1],
    fecha,
    fechaValidez,
    data.cliente_id || '',
    data.cliente || '',
    data.identificacion || '',
    data.estado || filaOriginal[7] || 'BORRADOR',
    subtotal,
    ivaPorcentaje,
    iva,
    total,
    data.condiciones || '',
    data.forma_pago || '',
    data.usuario || filaOriginal[14] || ''
  ]]);

  // Elimina detalles anteriores de esta proforma, de abajo hacia arriba.
  const valsD = hojaD.getDataRange().getValues();
  for (let i=valsD.length-1;i>=1;i--) {
    if (String(valsD[i][1]) === String(data.id)) hojaD.deleteRow(i+1);
  }
  if (detalles.length) {
    hojaD.getRange(hojaD.getLastRow()+1,1,detalles.length,9).setValues(detalles);
  }

  return {
    ok:true, success:true, message:'Proforma actualizada correctamente.',
    id:data.id, numero:filaOriginal[1],
    fecha:formatearFechaISO(fecha), fecha_validez:formatearFechaISO(fechaValidez),
    dias_validez:dias, cliente:data.cliente || '', identificacion:data.identificacion || '',
    iva_porcentaje:ivaPorcentaje, iva:iva, subtotal:subtotal, total:total,
    forma_pago:data.forma_pago || '', condiciones:data.condiciones || '', detalles:detallesEntrada
  };
}

function eliminarProforma(id) {
  if (!id) throw new Error('No se indicó la proforma.');
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const hojaP = ss.getSheetByName('PROFORMAS');
  const hojaD = ss.getSheetByName('DETALLE_PROFORMA');
  if (!hojaP || !hojaD) throw new Error('No existen las hojas de proformas.');

  const valsP = hojaP.getDataRange().getValues();
  let fila = -1;
  for (let i=1;i<valsP.length;i++) {
    if (String(valsP[i][0]) === String(id)) { fila=i+1; break; }
  }
  if (fila < 0) throw new Error('No se encontró la proforma.');

  const valsD = hojaD.getDataRange().getValues();
  for (let i=valsD.length-1;i>=1;i--) {
    if (String(valsD[i][1]) === String(id)) hojaD.deleteRow(i+1);
  }
  hojaP.deleteRow(fila);
  return {ok:true, success:true, message:'Proforma eliminada correctamente.'};
}

/* =========================
   LOGO DESDE GOOGLE DRIVE
========================= */

function obtenerLogoBase64(fileId) {
  if (!fileId) return '';

  try {
    const file = DriveApp.getFileById(fileId);
    const blob = file.getBlob();

    const contentType =
      blob.getContentType() || 'image/png';

    const base64 =
      Utilities.base64Encode(blob.getBytes());

    return 'data:' +
      contentType +
      ';base64,' +
      base64;

  } catch (e) {
    throw new Error(
      'No se pudo cargar el logo desde Google Drive: ' +
      e.message
    );
  }
}

/* =========================
   FECHAS

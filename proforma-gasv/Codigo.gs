/* =========================
   WEB APP
========================= */

function doGet(e) {
  // Web App principal y rutas auxiliares PWA.
  // IMPORTANTE: no dejamos que un error de configuración de Sheets
  // impida que Index.html llegue al navegador.
  const parametroPWA = e && e.parameter ? String(e.parameter.pwa || '') : '';

  if (parametroPWA === 'manifest') return obtenerManifestPWA_();
  if (parametroPWA === 'sw') return obtenerServiceWorkerPWA_();

  try {
    configurarSistema();
  } catch (error) {
    Logger.log('PROFORMA GASV - Error en configurarSistema(): ' + error);
  }

  try {
    return HtmlService.createTemplateFromFile('Index')
      .evaluate()
      .setTitle(NOMBRE_APP)
      // Icono del acceso directo (PNG publico en Drive: Logo/gasv-icon-192.png)
      .setFaviconUrl('https://drive.google.com/uc?id=1_dRvVquUfNLMRKsSbxqT_ogKB94Sazl0&export=view&format=.png')
      // Apps Script ignora el <meta viewport> escrito dentro de Index.html
      // (la app corre dentro de un iframe). Sin esta línea el iPhone muestra
      // la versión de escritorio reducida. Se agrega en la página contenedora.
      .addMetaTag('viewport', 'width=device-width, initial-scale=1, viewport-fit=cover')
      .addMetaTag('apple-mobile-web-app-capable', 'yes')
      .addMetaTag('mobile-web-app-capable', 'yes')
      .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
  } catch (error) {
    Logger.log('PROFORMA GASV - Error cargando Index.html: ' + error);

    const mensaje = String(error && error.message ? error.message : error);

    return HtmlService.createHtmlOutput(
      '<!doctype html>' +
      '<html lang=\"es\">' +
      '<head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">' +
      '<title>' + NOMBRE_APP + '</title>' +
      '<style>body{font-family:Arial,sans-serif;margin:40px;line-height:1.5;color:#111827}h1{color:#b91c1c}pre{white-space:pre-wrap;background:#f3f4f6;padding:16px;border-radius:8px}</style></head>' +
      '<body><h1>No se pudo cargar PROFORMA GASV</h1>' +
      '<p>El archivo <b>Index.html</b> no pudo ser procesado por Apps Script.</p>' +
      '<pre>' + escaparHtml_(mensaje) + '</pre>' +
      '<p>Revise que el archivo se llame exactamente <b>Index.html</b> y vuelva a implementar la versión actual.</p>' +
      '</body></html>'
    ).addMetaTag('viewport', 'width=device-width, initial-scale=1');
  }
}

function escaparHtml_(texto) {
  return String(texto || '')
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/\"/g, '&quot;')
    .replace(/'/g, '&#39;');
}


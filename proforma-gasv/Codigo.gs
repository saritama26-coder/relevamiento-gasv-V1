function generarIdCliente() {
  const hoja =
    SpreadsheetApp
      .getActiveSpreadsheet()
      .getSheetByName('CLIENTES');

  if (!hoja || hoja.getLastRow() <= 1) {
    return 'CLI-0001';
  }

  let mayor = 0;

  hoja
    .getRange(2, 1, hoja.getLastRow() - 1, 1)
    .getValues()
    .flat()
    .forEach(id => {
      if (!id) return;

      const n = Number(
        String(id).replace('CLI-', '')
      );

      if (!isNaN(n) && n > mayor) {
        mayor = n;
      }
    });

  return 'CLI-' + String(mayor + 1).padStart(4, '0');
}


function normalizarTelefonoEcuador(valor) {
  const texto = String(valor == null ? '' : valor).trim();

  if (!texto) return '';

  // Solo se aceptan dígitos. No se eliminan letras para evitar guardar
  // accidentalmente un teléfono inválido.
  if (!/^\d+$/.test(texto)) {
    throw new Error('El teléfono del cliente solo puede contener dígitos. Ejemplo: 0989124499.');
  }

  let telefono = texto;

  // Permite ingresar los 9 dígitos móviles sin el cero inicial.
  if (telefono.length === 9) {
    telefono = '0' + telefono;
  }

  if (telefono.length !== 10 || telefono.charAt(0) !== '0') {
    throw new Error('El teléfono del cliente debe contener exactamente 10 dígitos. Ejemplo: 0989124499.');
  }

  return telefono;
}

function normalizarTelefonosClientes() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const hoja = ss.getSheetByName('CLIENTES');
  if (!hoja || hoja.getLastRow() <= 1) return;

  hoja.getRange('D:D').setNumberFormat('@');

  const filas = hoja.getLastRow() - 1;
  const rango = hoja.getRange(2, 4, filas, 1);
  const valores = rango.getDisplayValues();

  const corregidos = valores.map(r => {
    const raw = String(r[0] || '').replace(/\D/g, '');
    if (raw.length === 9) return ['0' + raw];
    if (raw.length === 10 && raw.charAt(0) === '0') return [raw];
    return [r[0] || ''];
  });

  rango.setNumberFormat('@');
  rango.setValues(corregidos);
}

function guardarCliente(data) {
  if (!data || !data.nombre || !String(data.nombre).trim()) {
    throw new Error('El nombre del cliente es obligatorio.');
  }

  // Si llega un ID, se trata de una edición y nunca de un nuevo registro.
  // Esto evita crear duplicados cuando el formulario está en modo edición.
  if (data.id) {
    return actualizarCliente(data);
  }

  const ss = SpreadsheetApp.getActiveSpreadsheet();

  if (!ss.getSheetByName('CLIENTES')) {
    configurarSistema();
  }

  const hoja = ss.getSheetByName('CLIENTES');
  const id = generarIdCliente();
  const telefono = normalizarTelefonoEcuador(data.telefono);

  // Fuerza la columna D como texto antes de guardar para conservar 098...
  hoja.getRange('D:D').setNumberFormat('@');

  const fila = hoja.getLastRow() + 1;
  hoja.getRange(fila, 1, 1, 8).setValues([[
    id,
    String(data.nombre).trim(),
    data.identificacion || '',
    telefono,
    data.email || '',
    data.direccion || '',
    data.ciudad || '',
    new Date()
  ]]);

  hoja.getRange(fila, 4).setNumberFormat('@');

  return {
    ok: true,
    success: true,
    id: id,
    telefono: telefono,
    message: 'Cliente guardado correctamente.'
  };
}


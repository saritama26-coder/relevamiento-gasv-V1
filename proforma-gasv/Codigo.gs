function configurarSistema() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();

  crearHojaConfiguracion(ss);
  crearHojaClientes(ss);
  crearHojaProformas(ss);
  crearHojaDetalleProforma(ss);
  crearHojaServicios(ss);
  aplicarFormatoGeneral(ss);

  return {
    ok: true,
    mensaje: 'PROFORMA GASV configurada correctamente.'
  };
}

function obtenerOCrearHoja(ss, nombre) {
  let hoja = ss.getSheetByName(nombre);
  if (!hoja) hoja = ss.insertSheet(nombre);
  return hoja;
}

function crearEncabezados(hoja, encabezados) {
  const n = encabezados.length;

  if (hoja.getMaxColumns() < n) {
    hoja.insertColumnsAfter(
      hoja.getMaxColumns(),
      n - hoja.getMaxColumns()
    );
  }

  const rango = hoja.getRange(1, 1, 1, n);
  const actuales = rango.getValues()[0];

  let cambiar = false;

  for (let i = 0; i < n; i++) {
    if (actuales[i] !== encabezados[i]) {
      cambiar = true;
      break;
    }
  }

  if (cambiar) {
    rango.setValues([encabezados]);
  }
}


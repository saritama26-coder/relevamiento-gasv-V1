function obtenerConfiguracion() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();

  let hoja = ss.getSheetByName('CONFIGURACION');

  if (!hoja) {
    configurarSistema();
    hoja = ss.getSheetByName('CONFIGURACION');
  }

  const datos = hoja.getDataRange().getValues();
  const config = {};

  for (let i = 1; i < datos.length; i++) {
    if (datos[i][0]) {
      config[String(datos[i][0])] = datos[i][1];
    }
  }

  actualizarValoresBaseConfiguracion(config);

  // Normaliza configuraciones antiguas que puedan contener 0.15 en vez de 15.
  const ivaActual = Number(config.iva);
  if (isFinite(ivaActual) && ivaActual > 0 && ivaActual <= 1) {
    const ivaNormalizado = ivaActual * 100;
    const filaIVA = datos.findIndex(r => String(r[0] || '') === 'iva');
    if (filaIVA >= 1) {
      hoja.getRange(filaIVA + 1, 2).setValue(Number(ivaNormalizado.toFixed(2)));
    }
  }

  // Volver a leer para devolver al frontend los valores ya normalizados.
  const datosActualizados = hoja.getDataRange().getValues();
  const configFinal = {};

  for (let i = 1; i < datosActualizados.length; i++) {
    if (datosActualizados[i][0]) {
      configFinal[String(datosActualizados[i][0])] = datosActualizados[i][1];
    }
  }

  return configFinal;
}


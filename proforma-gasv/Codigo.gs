function guardarProforma(data) {
  if (!data) {
    throw new Error('No se recibieron datos de la proforma.');
  }

  if (!data.cliente && !data.cliente_id) {
    throw new Error('El cliente es obligatorio.');
  }

  /*
   * COMPATIBILIDAD:
   * El Index.html V2 envía:
   *   detalles
   *   iva_porcentaje
   *   cliente_id
   *
   * También aceptamos la nomenclatura anterior:
   *   servicios
   *   ivaPorcentaje
   *   clienteId
   */

  const detallesEntrada =
    Array.isArray(data.detalles)
      ? data.detalles
      : (Array.isArray(data.servicios)
          ? data.servicios
          : []);

  if (!detallesEntrada.length) {
    throw new Error(
      'Debe existir al menos un servicio en la proforma.'
    );
  }

  const ss = SpreadsheetApp.getActiveSpreadsheet();

  if (
    !ss.getSheetByName('PROFORMAS') ||
    !ss.getSheetByName('DETALLE_PROFORMA')
  ) {
    configurarSistema();
  }

  const hojaP = ss.getSheetByName('PROFORMAS');
  const hojaD = ss.getSheetByName('DETALLE_PROFORMA');

  const id = Utilities.getUuid();
  const numero = generarNumeroProforma();
  const fecha = new Date();
  const config = obtenerConfiguracion();

  const ivaPorcentaje =
    data.iva_porcentaje !== undefined &&
    data.iva_porcentaje !== ''
      ? Number(data.iva_porcentaje)
      : (
          data.ivaPorcentaje !== undefined &&
          data.ivaPorcentaje !== ''
            ? Number(data.ivaPorcentaje)
            : Number(config.iva) || 0
        );

  let subtotal = 0;
  const detalles = [];

  detallesEntrada.forEach(s => {
    const cantidad =
      Number(
        s.cantidad !== undefined
          ? s.cantidad
          : 0
      ) || 0;

    const precio =
      Number(
        s.precio_unitario !== undefined
          ? s.precio_unitario
          : (
              s.precio !== undefined
                ? s.precio
                : 0
            )
      ) || 0;

    const sub = cantidad * precio;

    subtotal += sub;

    detalles.push([
      Utilities.getUuid(),
      id,
      s.tipo_servicio || s.tipo || '',
      s.descripcion || '',
      s.unidad || '',
      cantidad,
      precio,
      sub,
      s.observaciones || ''
    ]);
  });

  if (subtotal <= 0) {
    throw new Error(
      'El subtotal de la proforma debe ser mayor que cero.'
    );
  }

  const iva =
    subtotal * ivaPorcentaje / 100;

  const total =
    subtotal + iva;

  const diasValidez =
    Number(
      data.dias_validez ||
      data.diasValidez ||
      config.dias_validez_predeterminados ||
      15
    );

  const fechaValidez = new Date(fecha);

  fechaValidez.setDate(
    fechaValidez.getDate() + diasValidez
  );

  const clienteId =
    data.cliente_id ||
    data.clienteId ||
    '';

  const formaPago =
    data.forma_pago ||
    data.formaPago ||
    config.forma_pago_predeterminada ||
    '';

  const condiciones =
    data.condiciones ||
    config.terminos_predeterminados ||
    '';

  hojaP.appendRow([
    id,
    numero,
    fecha,
    fechaValidez,
    clienteId,
    data.cliente || '',
    data.identificacion || '',
    'BORRADOR',
    subtotal,
    ivaPorcentaje,
    iva,
    total,
    condiciones,
    formaPago,
    data.usuario || 'Arq. Gabriel Alejandro Saritama Veira'
  ]);

  if (detalles.length) {
    hojaD
      .getRange(
        hojaD.getLastRow() + 1,
        1,
        detalles.length,
        detalles[0].length
      )
      .setValues(detalles);
  }

  return {
    success: true,
    ok: true,
    id: id,
    numero: numero,
    fecha: formatearFechaISO(fecha),
    fecha_validez: formatearFechaISO(fechaValidez),
    cliente: data.cliente || '',
    identificacion: data.identificacion || '',
    subtotal: subtotal,
    iva_porcentaje: ivaPorcentaje,
    iva: iva,
    total: total,
    condiciones: condiciones,
    forma_pago: formaPago,
    detalles: detallesEntrada.map(s => ({
      tipo_servicio: s.tipo_servicio || s.tipo || '',
      descripcion: s.descripcion || '',
      unidad: s.unidad || '',
      cantidad: Number(s.cantidad) || 0,
      precio_unitario:
        Number(
          s.precio_unitario !== undefined
            ? s.precio_unitario
            : s.precio
        ) || 0,
      observaciones: s.observaciones || ''
    }))
  };
}

/* =========================
   CONSULTAR UNA PROFORMA
========================= */

function obtenerProformaPorId(id) {
  if (!id) {
    throw new Error('No se indicó el ID de la proforma.');
  }

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const hojaP = ss.getSheetByName('PROFORMAS');
  const hojaD = ss.getSheetByName('DETALLE_PROFORMA');

  if (!hojaP || !hojaD) {
    throw new Error('No existen las hojas de proformas.');
  }

  const datosP = hojaP.getDataRange().getValues();

  let proforma = null;

  for (let i = 1; i < datosP.length; i++) {
    if (String(datosP[i][0]) === String(id)) {
      proforma = {
        id: datosP[i][0],
        numero: datosP[i][1],
        fecha: datosP[i][2] ? formatearFechaISO(datosP[i][2]) : '',
        fecha_validez: datosP[i][3] ? formatearFechaISO(datosP[i][3]) : '',
        cliente_id: datosP[i][4],
        cliente: datosP[i][5],
        identificacion: datosP[i][6],
        estado: datosP[i][7],
        subtotal: Number(datosP[i][8]) || 0,
        iva_porcentaje: Number(datosP[i][9]) || 0,
        iva: Number(datosP[i][10]) || 0,
        total: Number(datosP[i][11]) || 0,
        condiciones: datosP[i][12] || '',
        forma_pago: datosP[i][13] || '',
        usuario: datosP[i][14] || ''
      };
      break;
    }
  }

  if (!proforma) {
    throw new Error('No se encontró la proforma.');
  }

  const datosD = hojaD.getDataRange().getValues();

  proforma.detalles = datosD
    .slice(1)
    .filter(r => String(r[1]) === String(id))
    .map(r => ({
      id: r[0],
      proforma_id: r[1],
      tipo_servicio: r[2],
      descripcion: r[3],
      unidad: r[4],
      cantidad: Number(r[5]) || 0,
      precio_unitario: Number(r[6]) || 0,
      subtotal: Number(r[7]) || 0,
      observaciones: r[8] || ''
    }));

  const fechaBase = new Date(proforma.fecha);
  const fechaFin = new Date(proforma.fecha_validez);
  const diasValidez = Math.max(
    1,
    Math.round((fechaFin - fechaBase) / (1000 * 60 * 60 * 24))
  );

  return {
    success: true,
    ...proforma,
    dias_validez: diasValidez
  };
}



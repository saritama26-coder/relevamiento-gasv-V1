// Si se dispone de URLs HTTPS públicas para los iconos PNG, se pueden
// configurar aquí. Deben apuntar a imágenes reales de 192x192 y 512x512.
// Para iPhone/iPad, Index.html conserva además el logo embebido mediante
// apple-touch-icon, por lo que no depende de estas URLs.
const PWA_ICON_192_URL = 'data:image/png;base64,';
const PWA_ICON_512_URL = 'data:image/png;base64,';

function obtenerManifestPWA_() {
  const webAppUrl = ScriptApp.getService().getUrl() || '';
  const config = obtenerConfiguracion();
  const iconos = [];

  const icono192 = String(config.pwa_icon_192_url || '').trim() || PWA_ICON_192_URL;
  const icono512 = String(config.pwa_icon_512_url || '').trim() || PWA_ICON_512_URL;

  if (icono192) {
    iconos.push({
      src: icono192,
      sizes: '192x192',
      type: 'image/png',
      purpose: 'any maskable'
    });
  }
  if (icono512) {
    iconos.push({
      src: icono512,
      sizes: '512x512',
      type: 'image/png',
      purpose: 'any maskable'
    });
  }

  const manifest = {
    name: NOMBRE_APP,
    short_name: 'Proformas GASV',
    description: 'Gestión de Proformas, Clientes y Servicios — Gabriel Alejandro Saritama Veira',
    id: webAppUrl || './',
    start_url: webAppUrl || './',
    scope: webAppUrl || './',
    display: 'standalone',
    background_color: '#ffffff',
    theme_color: '#ffffff',
    orientation: 'portrait-primary',
    lang: 'es-EC',
    icons: iconos
  };

  return ContentService
    .createTextOutput(JSON.stringify(manifest))
    .setMimeType(ContentService.MimeType.JSON);
}

function obtenerServiceWorkerPWA_() {
  const script = `
const CACHE_NAME = 'proformas-gasv-v10';

self.addEventListener('install', function(event) {
  self.skipWaiting();
});

self.addEventListener('activate', function(event) {
  event.waitUntil(self.clients.claim());
});

self.addEventListener('fetch', function(event) {
  // Red de forma predeterminada para no almacenar respuestas dinámicas
  // de Google Apps Script ni datos privados de la aplicación.
  event.respondWith(fetch(event.request).catch(function() {
    return new Response(
      '<!doctype html><html lang="es"><body style="font-family:Arial;padding:24px"><h2>Proformas GASV</h2><p>Sin conexión. Vuelve a intentarlo cuando recuperes Internet.</p></body></html>',
      {headers:{'Content-Type':'text/html; charset=utf-8'}}
    );
  }));
});
`;

  return ContentService
    .createTextOutput(script)
    .setMimeType(ContentService.MimeType.JAVASCRIPT);
}


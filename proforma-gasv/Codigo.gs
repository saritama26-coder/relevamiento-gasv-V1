/* =========================
   NUMERACIÓN DE PROFORMAS
========================= */

function generarNumeroProforma() {
  const lock = LockService.getScriptLock();

  lock.waitLock(30000);

  try {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const hoja = ss.getSheetByName('PROFORMAS');

    if (!hoja) {
      throw new Error('No existe la hoja PROFORMAS.');
    }

    const año = new Date().getFullYear();
    const sufijo = '-' + PREFIJO_PROFORMA + '-' + año;

    let mayor = 0;

    if (hoja.getLastRow() > 1) {
      hoja
        .getRange(2, 2, hoja.getLastRow() - 1, 1)
        .getValues()
        .flat()
        .forEach(numero => {
          if (!numero) return;

          const texto = String(numero).trim();

          if (!texto.endsWith(sufijo)) return;

          const partes = texto.split('-');

          if (partes.length !== 3) return;

          const n = parseInt(partes[0], 10);

          if (!isNaN(n) && n > mayor) {
            mayor = n;
          }
        });
    }

    return (
      String(mayor + 1).padStart(3, '0') +
      sufijo
    );

  } finally {
    lock.releaseLock();
  }
}

